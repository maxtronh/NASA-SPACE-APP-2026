# Flame in Freefall - Next.js 15 Frontend Configuration
# When using Next.js proxy rewrites (next.config.mjs), client requests to /api/v1/:path*
# are automatically routed to NEXT_PUBLIC_API_URL or http://localhost:8000.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
# Public origin used for canonical metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
