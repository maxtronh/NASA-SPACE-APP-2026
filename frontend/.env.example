# Flame in Freefall - Next.js 15 Frontend Configuration
# Next.js proxy rewrites (next.config.mjs) route /api/v1/:path* to the backend.
# The URL is automatically sanitized so both http://localhost:8000 and http://localhost:8000/api/v1 are supported.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development
